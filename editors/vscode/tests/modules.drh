//                         ^^^ entity.name.function.drachm
        uint8 d = (damage * 1.5)::to<uint8>();
//                                ^^ entity.name.function.drachm
//                                   ^^^^^ meta.type-arguments.drachm storage.type.primitive.drachm
        Shape t = Shape::Empty;
//                       ^^^^^ entity.name.type.drachm
        Circle c = Circle::unit();
//                         ^^^^ entity.name.function.drachm
        phys::Vector3 v = 1, 2, 3;
//            ^^^^^^^ entity.name.type.drachm
        uint32 n = max<uint32>(5, 9);
//                 ^^^ entity.name.function.call.drachm
//                     ^^^^^^ meta.type-arguments.drachm storage.type.primitive.drachm
        uint32 m = max(a, b);
//                 ^^^ entity.name.function.call.drachm
        self.items::push(item);
//           ^^^^^ variable.other.property.drachm
//                  ^^^^ entity.name.function.drachm
        p.x = 1;
//       ^ punctuation.accessor.drachm
//        ^ variable.other.property.drachm
        fs::open(path);
//          ^^^^ entity.name.function.drachm - storage.modifier.drachm
        Vector3 p = new Vector3 of (x: 1, y: 2, z: 3);
//                      ^^^^^^^ support.type.builtin.drachm
        names::each((string n) => io::outln(n));
//                   ^^^^^^ storage.type.primitive.drachm
//                             ^^ keyword.operator.arrow.drachm
        for (uint32 i of 0..9) { }
