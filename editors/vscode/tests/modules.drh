//                 ^^^^^ variable.other.property.drachm
    out Vector3, gravity;
//  ^^^ keyword.control.import.drachm
        io::outln(answer::text());
//        ^^ keyword.operator.accessor.drachm
//          ^^^^^ entity.name.function.drachm
//                        ^^^^ entity.name.function.drachm
        "dcba"::reverse()->sub(0, 1);
//              ^^^^^^^ entity.name.function.drachm
