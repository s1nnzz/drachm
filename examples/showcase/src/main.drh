//--!$unsafe: true
// ============================================================================
//  SHOWCASE: the voyage of the survey ship Drachma
//
//  One project, everything the compiler accepts today. The voyage is told in
//  five chapters, one file each under src/voyage/; this file imports them in
//  the different ways a file can:
//
//      in voyage.units;                          a module under its own name
//      in voyage.crew as crew;                   a module under a name of your choice
//      in * from voyage.systems as systems;      every exported name, under systems::
//      in * from rules as rules also bare;       under rules:: and bare, too
//                                                (drachm.toml has import_clash = "error": a bare
//                                                name that hid another would be an error)
//      in Order from voyage.orders;              single items
//      in * from c."harbour.h" as harbour;       a C header (src/voyage/ports.drh)
//
//  Run it with:
//      drachm run examples/showcase        (Cranelift)
//      drachm run examples/showcase -O     (via C; must print the same)
// ============================================================================
in io;
in fs;
in os;
in chart_depth from charts.survey.readings;
in voyage.units;
in voyage.crew as crew;
in * from voyage.systems as systems;
in * from rules as rules also bare;
in voyage.mission;
in voyage.cargo as cargo;
in voyage.ports as ports;
in voyage.logbook as logbook;

none main() {
    io::outln(f"the survey ship Drachma: ${BAYS} cargo bays, ${rules::RACK_SLOTS} rack slots");
    io::outln(f"depth correction: ${rules::downward_correction(240)}, chart depth: ${chart_depth()}");
    io::outln(f"hull ${rules::hull(7)::upper()}, also ${rules::hull(7)->lower()}");
    io::outln("");
    units::run();
    crew::run();
    systems::run();
    mission::run();
    cargo::run();
    ports::run();
    logbook::run();
    string platform = os::platform();
    if (platform != "") { io::outln("voyage platform available"); }
    string manifest = fs::read("examples/showcase/drachm.toml") maybe "";
    if (manifest != "") { io::outln("read voyage manifest"); }
    io::outln("-- end of voyage --");
}
