//--!$unsigned_negate: signed
// Ship-wide constants. Constants can be exported like anything else, and
// they can size types in the files that import them.
// A top-level value with a constant initializer is a named constant, and it
// can size a type. `fixed` makes the compiler check that it is constant.
out uint32 BAYS = 3;
out fixed uint32 RACK_SLOTS = BAYS;

// The ship's name from its hull number. A call through a module can start a
// chain: `rules::hull(7)::upper()` and `rules::hull(7)->lower()` both work.
out string hull(uint32 n) { return "Drachma-" + n::text(); }

// A downward correction is signed even though the sensor reports a magnitude.
out sint16 downward_correction(uint8 magnitude) {
    return -magnitude;
}

// Tests sit beside the rules they check. `drachm test examples/showcase` runs
// them, one program each; a normal run compiles them and never runs them.
test "the hull is named from its number" {
    assert(hull(7) == "Drachma-7");
}

// `expect failure` passes when the call fails with the named failure, and
// stops the test with a message when it does not.
test "a sensor reading that is not a number is refused" {
    expect failure ConvertError from "n/a"::to<uint32>();
}

test "a downward correction is negative" {
    assert(downward_correction(240) == -240);
    assert(downward_correction(0) == 0, "no sensor reading means no correction");
}
