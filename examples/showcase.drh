// ============================================================================
//  SHOWCASE: the voyage of the survey ship Drachma
//
//  One program, everything the compiler accepts today. Each "Part" below says
//  which features it shows off. Run it with:
//      drachm run examples/showcase.drh        (Cranelift)
//      drachm run examples/showcase.drh -O     (via C; must print the same)
// ============================================================================
in io;
in si;

// ---------------------------------------------------------------------------
// Part 1: units of measure, generics over units, numbers of every width
// ---------------------------------------------------------------------------
unit ly = 9460730472580800 m;            // our own unit, built from a metre

// A generic struct with a unit parameter: one logbook for any unit.
struct Log<Num, unit U> {
public:
    Num entries;
    float64<U> total;
    float64<U> mean() { return self.total / self.entries; }
}

// One function for every unit; the unit is worked out from the argument.
float64<U> doubled<unit U>(float64<U> x) {
    return x * 2.0;
}

// `tesla as unit` names the unit in full, even where a type parameter `T` is in scope.
float64<tesla as unit> boosted<T>(float64<tesla as unit> b) {
    return b * 2.0;
}

none part1() {
    io::outln("== Part 1: numbers and units ==");
    uint8 crew = 200;
    sint16 deck = -12;
    uint64 stars = 1_000_000_000_000;
    uint128 atoms = 2 ** 100;
    float32 hull = 2.5f32;
    uint32 mask = 0xff;
    io::outln(f"crew ${crew}, deck ${deck}, stars ${stars}, hull ${hull}, mask ${mask}");
    io::outln(f"atoms in the cargo hold: ${atoms}");
    mut uint8 hearts = 250;
    for (uint32 i of 0..9) { hearts++; }
    io::outln(f"overflow wraps: 250 + 10 = ${hearts}");
    // `by` steps a range: the counter lands on 0, 5, 10, 15 and 20, and stops there.
    mut uint32 pulses = 0;
    for (uint32 beat of 0..20 by 5) { pulses = pulses + beat; }
    io::outln(f"beats 0 to 20 by 5 sum to ${pulses}");
    // A negative step counts down: the countdown lands on 10, 8, 6, 4, 2 and 0.
    mut string countdown = "";
    for (sint32 t of 10..0 by -2) { countdown = countdown + t::text() + " "; }
    io::outln(f"countdown: ${countdown}");
    // A float range: value k is 0.0 + k * 0.25, stopping at the last value not past 1.0.
    mut float64 gauge = 0.0;
    for (float64 level of 0.0..1.0 by 0.25) { gauge = gauge + level; }
    io::outln(f"gauge steps add up to ${gauge::text()}");

    float64<kg> mass = 4000.0<kg>;
    float64<m/s^2> thrust = 12.5<m/s^2>;
    float64<N> force = mass * thrust;
    io::outln(f"force: ${force::text()} ${force::unitText()}");
    float64<km/h> cruise = 72.0<km/h>;
    io::outln(f"cruise: ${cruise::in<m/s>()->text()} m/s");
    float64<degC> cabin = 21.0<degC>;
    io::outln(f"cabin: ${cabin::in<K>()->text()} K");

    Log<float64, unit m> run = new Log<float64, unit m> of (4.0, 10.0<m>);
    Log<float64, unit km> leg = new Log<float64, unit km> of (2.0, 9.0<km>);
    io::outln(f"mean run ${run::mean()->text()} ${run::mean()->unitText()}, mean leg ${leg::mean()->text()} ${leg::mean()->unitText()}");
    io::outln(f"doubled: ${doubled(5.0<s>)::text()} ${doubled(5.0<s>)::unitText()}");
    float64<ly> gap = 4.2<ly>;
    io::outln(f"nearest star: ${gap::in<m>()->text()} m");
    // tesla is the SI unit of magnetic flux density.
    float64<tesla> flux = 0.5<tesla>;
    io::outln(f"flux: ${flux::text()} ${flux::unitText()}");
    float64<tesla> boost = boosted<uint32>(flux);
    io::outln(f"boost: ${boost::text()} ${boost::unitText()}");
    io::outln("");
}

// ---------------------------------------------------------------------------
// Part 2: structs, constructors, def/fill, operator methods, text, lists, maps
// ---------------------------------------------------------------------------
enum Rank { Cadet, Pilot, Captain }

// `def` names a bundle of default field values; `fill ... with` applies it.
def Rookie of Member { hp = 100; rank = Cadet; missions = 0; }
def Veteran of Member from Rookie { hp = 180; }

struct Member defaults Rookie {
public:
    string name;
    uint32 hp;
    Rank rank;
    mut uint32 missions;

    none fly() { self.missions++; }
    string label() { return self.name::padRight(8, " ") + " hp " + self.hp::text()->padLeft(3, " "); }
}

// Fields by position, by name, or built by a constructor with `new ... of`.
struct Vec2 {
public:
    float64 x;
    float64 y;

    Vec2 +(Vec2 o) { return new Vec2 of (self.x + o.x, self.y + o.y); }
    Vec2 *(float64 k) { return new Vec2 of (self.x * k, self.y * k); }
    float64 len2() { return self.x * self.x + self.y * self.y; }
    static Vec2 origin() { return new Vec2 of (0.0, 0.0); }
}

Member recruit(string name, bool vet) {
    Member m;
    if (vet) {
        fill m with Veteran { m.name = name; }
    } else {
        fill m with defaults { m.name = name; }
    }
    return m;
}

none part2() {
    io::outln("== Part 2: the crew ==");
    // A manifest arrives as text; split, lines, chars and trim take it apart.
    string manifest = "  Ada:vet\nBo:cadet\nCy:vet\nDee:cadet\nEli:vet  ";
    string[?] rows = manifest::trim()->lines();
    mut Member[?] crew;
    for (&string row of rows) {
        string[?] parts = row::split(":");
        crew::push(recruit(copy parts[0], parts[1] == "vet"));
    }
    string letters = "ABCDE"::chars()->join(" ");
    io::outln(f"${crew::len()} recruits, first letters: ${letters}");

    // Index (negative counts from the end), change in place, call methods.
    crew[0].rank = Captain;
    crew[-1].rank = Pilot;
    crew[1]::fly();
    crew[1]::fly();
    io::outln("member          rank      trips");
    for (&Member m of crew) {
        mut string rank = "";
        match (m.rank) {
            case Captain { rank = "captain"; }
            case Pilot { rank = "pilot"; }
            case Cadet { rank = "cadet"; }
        }
        io::outf("% %-9 %\n", m::label(), rank, m.missions);
    }

    // Operator methods and a plain struct.
    Vec2 a = 3.0, 4.0;
    Vec2 b = y: 1.0, x: 1.0;
    Vec2 c = (a + b) * 2.0;
    io::outln(f"vector ${c.x}, ${c.y}; length squared ${c::len2()}; origin ${Vec2::origin().x}");

    // Maps: counting words, composite keys, OrderedMap keeps insertion order.
    mut Map<string, uint32> seen;
    for (string w of "the ship the crew the stars"::split(" ")) {
        if (seen[copy w] is empty) { seen[copy w] = 0; }
        seen[w] += 1;
    }
    uint32 the = seen["the"] maybe 0;
    io::outln(f"'the' appears ${the} times among ${seen::len()} distinct words");
    mut OrderedMap<string, uint32> fuel = { "alpha": 40, "beta": 25, "gamma": 90 };
    fuel["beta"] += 10;
    for (string tank, uint32 litres of fuel) {
        io::outln(f"  tank ${tank::upper()}: ${litres} L");
    }

    // Text methods, arrays, list equality, `for` over text.
    string log = "Day 1: all quiet. Day 2: all quiet. Day 3: comet!";
    io::outln(f"log has ${log::len()} chars, ${log::count("quiet")} quiet days, first '!' at ${log::find("!")}");
    io::outln(log::sub(0, 4) + " | " + log::replace("all quiet", "calm")->sub(-12, -1)->upper());
    uint8[4] rgba = [255, 128, 0, 255];
    uint32[?] a1 = [1, 2, 3];
    uint32[?] a2 = [1, 2, 3];
    io::outln(f"alpha ${rgba[-1]}, lists equal: ${a1 == a2}, contains 2: ${a1::contains(2)}");
    mut string glyphs = "";
    for (string ch of "navi") { glyphs = ch::upper() + "." + glyphs; }
    io::outln(f"reversed initials: ${glyphs}");
    io::outln("");
}

// ---------------------------------------------------------------------------
// Part 3: interfaces, generics, dynamic borrows, Iterable, built-in interfaces
// ---------------------------------------------------------------------------
interface Positioned {
    float64 x;                          // a required field
    float64 y;
}

interface Module {
    string name();
    float64 power();
    static Self standard();             // `Self` is whoever implements it
}

// Interfaces build on each other; `changes self` marks a mutating method.
interface Chargeable extends Module and Positioned {
    none charge(float64 amount) changes self;
}

struct Reactor with Chargeable {
public:
    float64 x;
    float64 y;
    mut float64 level;
    string name() { return "reactor"; }
    float64 power() { return self.level * 10.0; }
    none charge(float64 amount) { self.level += amount; }
    static Reactor standard() { return new Reactor of (0.0, 0.0, 5.0); }
}

struct Drive with Module {
public:
    uint32 thrusters;
    string name() { return "drive"; }
    float64 power() { return self.thrusters::to<float64>() * 7.5; }
    static Drive standard() { return new Drive of (4); }
}

// A generic function constrained by an interface; checked once, here.
float64 pair_power<X with Module>(X a, X b) { return a::power() + b::power(); }

// A generic struct that is itself a Module whenever what it holds is.
struct Bank<X with Module> with Module {
public:
    X left;
    X right;
    string name() { return f"bank of ${self.left::name()}s"; }
    float64 power() { return pair_power(self.left, self.right); }
    static Bank<X> standard() { return new Bank<X> of (X::standard(), X::standard()); }
}

// Dynamic dispatch: which `power` runs is decided while the program runs.
none report(&Module m) {
    string label = m::name()->padRight(16, ".");
    string watts = m::power()->text()->padLeft(7, " ");
    io::outln(f"  ${label} ${watts} kW");
}

none boost(&mut Chargeable c) {
    c::charge(1.5);
    c::charge(1.5);
}

none where_is(&Positioned p) { io::outln(f"  located at (${p.x}, ${p.y})"); }

// `&Chargeable` upcasts to `&Module` and `&Positioned` when passed along.
none inspect(&Chargeable c) {
    report(c);
    where_is(c);
}

// Types you do not own can promise your interface from outside.
interface Describe { string describe(); }

uint8 with Describe {
    string describe() { return f"a byte, ${self}"; }
}

Drive with trusted Describe {
    string describe() { return f"a drive with ${self.thrusters} thrusters"; }
}

string say<X with Describe>(X v) { return v::describe(); }

// Built-in interfaces: Zero, Equal, Ordered, Text.
X biggest<X with Ordered>(X a, X b) { if (a > b) { return a; } return b; }
X or_zero<X with Zero>(X v, bool ok) { if (ok) { return v; } return X::zero(); }
string same<X with Equal>(X a, X b) { if (a == b) { return "equal"; } return "different"; }
string shout<X with Text>(X v) { return v::text()->upper() + "!"; }

// A generic interface and an Iterable collection of our own.
interface Source<X> { X next() changes self; }

struct Fuel with Source<uint32> {
public:
    mut uint32 left;
    uint32 next() { self.left -= 10; return self.left; }
}

struct Convoy with Iterable<Drive> {
public:
    uint32 size;
    Drive? at(uint64 i) {
        if (i >= self.size) { return none; }
        return new Drive of (i::to<uint32>() + 1);
    }
}

X draw_from<X, Src with Source<X>>(&mut Src s) { return s::next(); }

// A top-level value with a constant initializer is a named constant, and it
// can size a type. `fixed` makes the compiler check that it is constant.
uint32 BAYS = 3;
fixed uint32 RACK_SLOTS = BAYS;

// A value parameter puts a number into the type: a rack has a fixed number of
// slots, and `Rack<uint32, 3>` is not `Rack<uint32, 4>`.
struct Rack<X, uint32 Slots> {
public:
    X[Slots] mounts;
    static uint32 slots() { return Slots; }
    X mounted(uint32 i) { return copy self.mounts[i]; }
}

// The length is worked out from the array that is passed in.
float64 total_draw<uint32 Len>(&float64[Len] draws) {
    mut float64 total = 0.0;
    for (float64 d of draws) { total += d; }
    return total;
}

uint32 count_of<X, uint32 Len>(&X[Len] items) { return Len; }

// A calculation on a value parameter is worked out for each instance, so a
// `Locker<uint32, 3>` has four shelves: one more than the rack has slots.
struct Locker<X, uint32 Slots> {
public:
    X[Slots + 1] shelves;
    static uint32 shelf_count() { return Slots + 1; }
}

none part3() {
    io::outln("== Part 3: ship systems ==");
    mut Reactor core = Reactor::standard();
    Drive engine = Drive::standard();
    io::outln("power report:");
    report(&core);
    report(&engine);
    boost(&mut core);
    inspect(&core);
    Bank<Drive> twin = Bank<Drive>::standard();
    report(&twin);
    io::outln(f"  two reactors: ${pair_power(core, core)} kW");

    io::outln(say(7u8));
    io::outln(say(engine));
    io::outln(f"${biggest(3, 9)} ${biggest(2.5, 1.5)} ${or_zero(8, false)} ${same("a", "a")} ${same(1, 2)}");
    io::outln(shout(42));

    mut Fuel tank = 100;
    io::outln(f"drawn: ${draw_from<uint32, Fuel>(&mut tank)} then ${draw_from<uint32, Fuel>(&mut tank)}");
    Convoy convoy = new Convoy of (3);
    mut float64 convoy_power = 0.0;
    for (Drive d of convoy) { convoy_power += d::power(); }
    io::outln(f"convoy of ${convoy.size} draws ${convoy_power} kW");
    Rack<uint32, RACK_SLOTS> rack = new Rack<uint32, RACK_SLOTS> of ([4, 8, 15]);
    Locker<uint32, RACK_SLOTS> locker = new Locker<uint32, RACK_SLOTS> of ([1, 2, 3, 4]);
    float64[RACK_SLOTS] draws = [core::power(), engine::power(), convoy_power];
    io::outln(f"a rack of ${Rack<uint32, RACK_SLOTS>::slots()} holds ${rack::mounted(2)} in its last slot; ${count_of(&draws)} draws total ${total_draw(&draws)} kW");
    io::outln(f"the locker beside it has ${Locker<uint32, RACK_SLOTS>::shelf_count()} shelves, ${locker.shelves::len()} of them in use");
    io::outln("");
}

// ---------------------------------------------------------------------------
// Part 4: enums with data, match, optionals, failures, skip, loop control
// ---------------------------------------------------------------------------
enum Order {
    Jump(float64 distance),
    Scan(string target),
    Repair(string part, uint32 amount),
    Hail(string who),
    Rest,
}

// A failure type lists its variants; each has a message and may set the exit code.
failure ShipError {
    UnknownOrder(string word) f"unknown order '${word}'" exit 2,
    BadNumber(string text) f"'${text}' is not a number",
    MissingArgument(string word) f"'${word}' needs an argument",
    OutOfFuel(uint32 short) f"short by ${short} units of fuel" exit 3,
    TooFar(float64 distance) f"${distance} ly is beyond the drive's range" exit 4,
}

struct Ship {
public:
    string name;
    mut uint32 fuel;
    mut uint32 hull;
    mut float64 travelled;
}

float64 number(string text) fails ShipError {
    // `to<T>()` fails with the built-in ConvertError; turn it into ours.
    return text::to<float64>() fails with (ConvertError e) => {
        fail BadNumber(copy text) because e;
    };
}

Order parse(string line) fails ShipError {
    string[?] w = line::split(" ");
    string verb = copy w[0];
    if (verb == "rest") { return Rest; }
    if (w::len() < 2) { fail MissingArgument(verb); }
    match (verb) {
        case "jump" { return Jump(number(copy w[1]) fails); }
        case "scan" { return Scan(copy w[1]); }
        case "hail" { return Hail(copy w[1]); }
        case "repair" {
            if (w::len() < 3) { fail MissingArgument(verb); }
            uint32 amount = w[2]::to<uint32>() maybe 1;
            return Repair(copy w[1], amount);
        }
        case _ { fail UnknownOrder(verb); }
    }
}

none obey(&mut Ship ship, &Order order) fails ShipError {
    match (order) {
        case Jump(float64 d) if d > 100.0 {
            fail TooFar(d);
        }
        case Jump(float64 d) {
            uint32 cost = (d * 3.0)::to<uint32>();
            if (cost > ship.fuel) { fail OutOfFuel(cost - ship.fuel); }
            ship.fuel -= cost;
            ship.travelled += d;
            io::outln(f"  jumped ${d} ly, fuel left ${ship.fuel}");
        }
        case Scan(copy string target) {
            match (target) {
                case globbed "planet-*" { io::outln(f"  ${target}: habitable, probably"); }
                case "sun", "star" { io::outln("  hot. very hot."); }
                case _ { io::outln(f"  ${target}: nothing of interest"); }
            }
        }
        case Repair(copy string part, uint32 amount) {
            ship.hull += amount;
            io::outln(f"  repaired the ${part} (+${amount}), hull ${ship.hull}");
        }
        case Hail(copy string who) { io::outln(f"  ${who} replies: 'greetings, ${ship.name}'"); }
        case Rest { io::outln("  the crew naps"); }
    }
}

// An optional: a part may or may not be in the stores.
string? stockroom(string part) {
    match (part) {
        case "coil", "valve" { return f"spare ${part}"; }
        case _ { return none; }
    }
}

none part4() {
    io::outln("== Part 4: the mission script ==");
    mut Ship ship = new Ship of ("Drachma", 30, 80, 0.0);
    string script = """jump 4.5
scan planet-9
hail Vega
repair coil 7
dance wildly
jump 1x
jump
jump 500
scan sun
jump 9
rest""";
    mut uint32 done = 0;       // lines read
    mut uint32 failed = 0;
    for (string line of script::lines()) {
        io::outln(f"> ${line}");
        Order order = parse(copy line) fails with (ShipError e) => {
            io::outln(f"  rejected: ${e}");
            failed++;
            maybe Rest;
        };
        // A handler can also cover many failure types at once and read the exit code.
        obey(&mut ship, &order) fails with (any e) => {
            io::outln(f"  failed: ${e::message()} (exit code ${e::exit()})");
            failed++;
        };
        done++;
    }
    io::outln(f"orders: ${done} read, ${failed} refused or failed");
    io::outln(f"travelled ${ship.travelled} ly on ${ship.fuel} fuel; hull ${ship.hull}");

    // Failures can also be ignored on purpose, and say so in the code.
    obey(&mut ship, &Order::Jump(900.0)) ignore failure;
    obey(&mut ship, &Order::Jump(900.0)) fails with none;
    uint32 spare = "12x"::to<uint32>() maybe 0;
    io::outln(f"ignored two failed jumps; a bad reading falls back to ${spare}");

    // Optionals: `maybe` supplies a fallback, `is empty` asks.
    string[?] wanted = ["coil", "warp core", "valve"];
    for (&string part of wanted) {
        string? found = stockroom(copy part);
        if (found is empty) {
            io::outln(f"  no ${part} in stores");
            continue;
        }
        io::outln(f"  ${part}: " + (found maybe "?"));
    }

    // Loop control with counts: leave both loops as soon as a hazard is found.
    mut string hazard = "none";
    for (uint32 row of 0..4) {
        for (uint32 col of 0..4) {
            if (col > row) { continue 2; }
            if (row * col == 6) { hazard = f"asteroid at ${row},${col}"; break 2; }
        }
    }
    io::outln(f"sector scan: ${hazard}");
    io::outln("");
}

// ---------------------------------------------------------------------------
// Part 5: ownership, borrows, lives, drop, take/copy, lambdas, skip
// ---------------------------------------------------------------------------
struct Crate {
public:
    string label;
    uint32 mass;

    // Runs by itself when the owner goes out of scope (or on `destroy`).
    none drop() { io::outln(f"  [crate ${self.label} unloaded]"); }
}

// A struct that holds a borrow names the borrow field in its head.
struct Reader lives src {
public:
    &string src;
    mut uint64 pos;
    none advance(uint64 n) { self.pos += n; }
    uint64 left() { return self.src::len() - self.pos; }
}

// Two borrows could be the source of the result: `lives` says which.
&string longer(&string a, &string b) lives a, b {
    if (a::len() >= b::len()) { return a; }
    return b;
}

// Taking a value by value moves it in: the caller cannot use it afterwards.
uint32 weigh(Crate c) { return c.mass; }

none grow(&mut string s) { s += "!"; }

none shout_twice(&mut string s) {
    grow(lend s);               // `lend` reborrows without giving it away
    grow(lend s);
}

// A function taking a function: `(uint32) => uint32` is a function type.
uint32 apply_all(&uint32[?] xs, (uint32) => uint32 f) {
    mut uint32 total = 0;
    for (uint32 n of xs) { total += f(n); }
    return total;
}

string gauge(uint32 fuel) {
    mut string verdict = "plenty";
    if (fuel < 50) {
        verdict = "low";
        if (fuel < 10) {
            verdict = "critical";
            skip;                   // leave the enclosing `if`, keep the verdict
        }
        verdict = verdict + ", refuel soon";
    }
    return verdict;
}

none part5() {
    io::outln("== Part 5: cargo and ownership ==");
    Crate a = "seed vault", 120;
    Crate b = "tea", 8;
    io::outln(f"weighing crate b: ${weigh(b)} kg");      // `b` moved into weigh and dropped there
    destroy a;                                           // explicit early drop
    io::outln("  a is gone, the hold is empty");

    // Borrow, copy, take: three ways to get at a value that someone else owns.
    string captain = "Okonkwo";
    string slogan = "per aspera ad astra";
    io::outln(f"longer: ${longer(&captain, &slogan)}");
    mut Reader r = &slogan, 0;
    r::advance(4);
    io::outln(f"reader left ${r::left()} of ${slogan::len()}");

    // `maybe &string` is an optional that holds a borrow: a view of a port name,
    // or none when the list has no such item.
    string[?] ports = ["Vega", "Sol"];
    string nowhere = "deep space";
    maybe &string first_port = ports::first();
    maybe &string ninth_port = ports::get(8);
    io::outln(f"first port ${first_port maybe &nowhere}, ninth port ${ninth_port maybe &nowhere}");
    // `same as` asks whether two borrows are the same place, not the same text.
    string twin_slogan = "per aspera ad astra";
    io::outln(f"the longer one is the slogan itself: ${longer(&captain, &slogan) same as &slogan}; a copy of it is not: ${&slogan same as &twin_slogan}");
    // `containsRef` asks the same of a list of borrows: is this exact place in it?
    List<&string> banner = [&captain, &slogan];
    io::outln(f"the banner holds the slogan: ${banner::containsRef(&slogan)}, its twin: ${banner::containsRef(&twin_slogan)}");
    io::outln(f"a copy is not the slogan: ${&twin_slogan not same as &slogan}, the slogan is not a copy: ${&slogan not same as &slogan}");

    mut string note = "mayday";
    shout_twice(&mut note);
    string kept = copy note;
    note = "all clear";
    io::outln(f"${kept} / ${note}");

    mut Crate c = "relics", 40;
    string tag = take c.label leaving "(empty)";
    io::outln(f"took label '${tag}', crate now '${c.label}'");

    mut string[?] queue = ["alpha", "beta", "gamma", "delta"];
    string second = take queue[1] reorders;
    io::outln(f"took ${second}; queue is ${queue::join(", ")}");
    // `leaving v` keeps the length and the order: the new word takes the old one's place.
    string third = take queue[1] leaving "omega";
    io::outln(f"took ${third}; queue is now ${queue::join(", ")}");

    // Lambdas: capture by reference, `move` to capture a copy, function types.
    mut uint32 calls = 0;
    uint32 factor = 3;
    uint32[?] loads = [4, 5, 6];
    uint32 sum = apply_all(&loads, (uint32 n) => { calls++; return n * factor + 1; });
    mut uint32 grand = 0;
    loads::each((uint32 n) => { grand += n; });
    io::outln(f"lambda total ${sum} after ${calls} calls; loads sum to ${grand}");
    string motto = "ad astra";
    () => none sing = move () => io::outln(f"  the crew sings: ${motto}");
    sing();
    sing();

    for (uint32 fuel of [75, 30, 5]) {
        io::outln(f"  fuel ${fuel}: ${gauge(fuel)}");
    }
    io::outln("  leaving part 5; c drops now");
}

none main() {
    part1();
    part2();
    part3();
    part4();
    part5();
    io::outln("-- end of voyage --");
}
