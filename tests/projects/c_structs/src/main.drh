//--!$unsafe: true
in io;
in * from c."drachm_fixture.h" as fx;

// A wrapper that owns a C handle and releases it itself.
struct Counter {
    foreign *fx::fx_counter handle;

    none add(sint32 n) {
        unsafe { fx::fx_counter_add(self.handle, n::to<c::int>()); }
    }

    sint32 get() {
        unsafe { return fx::fx_counter_get(self.handle)::to<sint32>(); }
    }

    none drop() {
        unsafe { fx::fx_counter_free(self.handle); }
    }
}

Counter makeCounter(sint32 start) {
    unsafe {
        return new Counter of (handle: fx::fx_counter_new(start::to<c::int>()));
    }
}

sint32 alive() {
    unsafe { return fx::fx_counters_alive()::to<sint32>(); }
}

sint32 work(sint32 early) {
    Counter c = makeCounter(10);
    c::add(5);
    if (early == 1) {
        return c::get();
    }
    c::add(100);
    return c::get();
}

none main() {
    // A C struct is a plain value struct with its exact layout.
    mut fx::fx_point p = 3, 4;
    p.x += 10;
    unsafe { fx::fx_point_move(address of p, 1, 1); }
    io::outln(f"point: ${p.x::to<sint32>()}, ${p.y::to<sint32>()}");

    mut fx::fx_rect r = origin: p, w: 6, h: 7;
    r.origin.y = 9;
    io::outln(f"rect: ${r.origin.x::to<sint32>()}, ${r.origin.y::to<sint32>()}, ${r.w::to<sint32>()}x${r.h::to<sint32>()}");

    fx::fx_size s = 1.5, 2.5;
    io::outln(f"size: ${s.w::to<float64>()} ${s.h::to<float64>()}");

    io::outln(f"work: ${work(1)} ${work(0)}");
    io::outln(f"alive: ${alive()}");
}
