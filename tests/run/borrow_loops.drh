in io;
none main() {
    string a = "a";
    string b = "b";
    string c = "c";
    mut &string cur = &a;
    mut uint32 i = 0;
    while (i < 3) {
        io::outln(cur);
        if (i == 0) { cur = &b; } else { cur = &c; }
        i += 1;
    }
    mut string s = "x";
    mut uint32 j = 0;
    while (j < 3) {
        &string t = &s;
        io::outln(t);
        s += "y";
        j += 1;
    }
    mut uint32 k = 0;
    while (true) {
        &string u = &s;
        k += 1;
        if (k == 2) {
            io::outln(u);
            break;
        }
    }
    s = "done";
    io::outln(s);
}
