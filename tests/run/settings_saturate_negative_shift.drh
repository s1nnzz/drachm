//--!$overflow: saturate
in io;

// A negative amount shifts the other way; the exact result clamps to the type.
none main() {
    // Untyped constants: no width, so the exact value; a typed use clamps.
    io::outln(f"const ${8 << -1} ${8 >> -1} ${8 >> -5} ${-8 >> -1} ${-9 << -1}");
    uint8 clamped = 200 >> -1;
    io::outln(f"typed ${clamped}");

    uint8 a = 8;
    uint8 big = 200;
    uint8 zero = 0;
    sint8 neg = -8;
    sint8 nbig = -100;
    io::outln(f"u8 ${a << -1} ${a >> -1} ${big >> -1} ${big >> -9} ${zero >> -9}");
    io::outln(f"u8 small ${a << -9} ${big << -9}");
    io::outln(f"s8 ${neg << -1} ${neg >> -1} ${nbig >> -1} ${neg >> -20} ${neg << -20} ${neg << -9}");

    // The amount is a variable too.
    sint32 minus = -3;
    uint32 wide = 1;
    io::outln(f"var ${wide >> minus} ${wide << minus} ${(-40) >> minus}");
    uint64 hi = 9223372036854775808;
    io::outln(f"u64 ${hi >> -1} ${hi << -1}");

    // Floats clamp at the ends; NaN is 0.
    float64 zeroF = 0.0;
    float64 inf = 1.0 / zeroF;
    float64 nan = zeroF / zeroF;
    io::outln(f"float ${inf::to<sint32>()} ${(-inf)::to<sint32>()} ${nan::to<sint32>()}");
    io::outln(f"float u8 ${inf::to<uint8>()} ${(-inf)::to<uint8>()} ${nan::to<uint8>()}");
    io::outln(f"float u64 ${inf::to<uint64>()} ${(-inf)::to<uint64>()}");
}
