//--!$unsafe: true
in io;
unsafe none swap(*uint32 a, *uint32 b) { unsafe { uint32 t = *a; *a = *b; *b = t; } }
none main() {
    mut uint32 x = 1;
    mut uint32 y = 2;
    unsafe {
        swap(address of x, address of y);
        swap(address of x, address of y);
    }
    io::outln(x::text());
}
