in io;

struct Countdown with Iterable<uint32> {
public:
    uint32 n;
    uint32? at(uint64 i) {
        if (i >= self.n) { return none; }
        return self.n - i::to<uint32>();
    }
}

Countdown make(uint32 n) {
    io::outln("made");
    return new Countdown of (n);
}

none main() {
    for (uint32 n of make(2)) { io::outln(n::text()); }
}
