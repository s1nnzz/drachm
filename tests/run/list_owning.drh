in io;

struct Person {
    public:
    string name;
    uint32 age;
}

string longest(&string[?] names) {
    mut uint64 best = 0;
    mut uint64 i = 1;
    while (i < names::len()) {
        if (names[i]::len() > names[best]::len()) {
            best = i;
        }
        i++;
    }
    return copy names[best];
}

none main() {
    mut string[?] names = ["ann", "robert"];
    string extra = "cy";
    names::push(extra);
    names::push("dorothea");
    io::outln(names::len()->text());
    io::outln(longest(&names));

    // Borrow and copy an item; the list keeps it.
    &string first = &names[0];
    io::outln(first);
    string kept = copy names[1];
    io::outln(kept);
    names[1] = "bob";
    io::outln(names[1]);
    io::outln(kept);

    names[0] += "!";
    io::outln(names[0]);

    mut Person[?] people = [new Person of ("ann", 30), new Person of ("bo", 41)];
    people::push(new Person of ("cy", 7));
    people[1].age += 1;
    people[2].name = "cyrus";
    io::outln(people[1].age::text());
    io::outln(people[2].name);
    mut uint64 i = 0;
    while (i < people::len()) {
        io::outln(f"${people[i].name} ${people[i].age}");
        i++;
    }

    string[?] twin = copy names;
    names[0] = "changed";
    io::outln(twin[0]);
    io::outln(twin::len()->text());
}
