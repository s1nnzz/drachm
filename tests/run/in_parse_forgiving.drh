in io;

none main() fails ConvertError {
    uint32 a = io::inln()->to<uint32>() fails;
    sint8 b = io::inln()->to<sint8>() fails;
    float64 c = io::inln()->to<float64>() fails;
    float64 d = io::inln()->to<float64>() fails;
    float32 e = io::inln()->to<float32>() fails;
    float64 f = io::inln()->to<float64>() fails;
    io::outln(a::text());
    io::outln(b::text());
    io::outln(c::text());
    io::outln(d::text());
    io::outln(e::text());
    io::outln(f::text());
}
