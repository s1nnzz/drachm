// if / else if / else, while, early return, shadowing, recursion.
fn classify(n: i64) -> i64 {
    if n < 0 {
        return 0 - 1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { return a; }
    return gcd(b, a % b);
}

fn noop() {
    return;
}

fn main() -> i64 {
    print(classify(0 - 5));
    print(classify(0));
    print(classify(5));
    var i: i64 = 0;
    var sum: i64 = 0;
    while i < 5 {
        let i2: i64 = i * i;
        sum = sum + i2;
        i = i + 1;
    }
    print(sum);
    let x: i64 = 1;
    if true {
        let x: bool = false;
        print(x);
    }
    print(x);
    print(gcd(48, 18));
    noop();
    print(false && 1 / 0 == 0);
    return 7;
}
