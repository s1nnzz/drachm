// The smallest signed value has no absolute value of the same type: `abs` follows the
// function's overflow setting like `-x` does. The default wraps around.
in io;
in math;

none main() {
    sint8 low = -128;
    io::outln(f"${math::abs(low)}");
    sint8 other = -127;
    io::outln(f"${math::abs(other)}");
}
