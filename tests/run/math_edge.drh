// Float edge cases of `math` give the same on both backends: NaN, negative zero, infinity.
in io;
in math;

none show(string label, float64 x) {
    io::outln(f"${label}: ${x::text()}");
}

none main() {
    float64 zero = 0.0;
    float64 nan = zero / zero;
    float64 inf = 1.0 / zero;
    float64 negzero = -zero;

    show("sqrt(-1)", math::sqrt(-1.0));
    show("sqrt(nan)", math::sqrt(nan));
    show("sqrt(inf)", math::sqrt(inf));
    show("sqrt(-0)", math::sqrt(negzero));
    show("log(0)", math::log(zero));
    show("log(-1)", math::log(-1.0));
    show("log2(8)", math::log2(8.0));
    show("log10(1000)", math::log10(1000.0));
    show("exp(0)", math::exp(zero));
    show("exp(inf)", math::exp(inf));
    show("exp(-inf)", math::exp(-inf));
    show("abs(-0)", math::abs(negzero));
    show("abs(-inf)", math::abs(-inf));
    show("abs(nan)", math::abs(nan));
    show("min(1, nan)", math::min(1.0, nan));
    show("min(nan, 1)", math::min(nan, 1.0));
    show("max(1, nan)", math::max(1.0, nan));
    show("max(nan, 1)", math::max(nan, 1.0));
    show("min(-inf, 3)", math::min(-inf, 3.0));
    show("max(inf, 3)", math::max(inf, 3.0));
    show("clamp(nan)", math::clamp(nan, 0.0, 1.0));
    show("clamp(inf)", math::clamp(inf, 0.0, 1.0));
    show("clamp(-inf)", math::clamp(-inf, 0.0, 1.0));
    show("floor(-0.5)", math::floor(-0.5));
    show("ceil(-0.5)", math::ceil(-0.5));
    show("round(-0.5)", math::round(-0.5));
    show("round(2.5)", math::round(2.5));
    show("round(-2.5)", math::round(-2.5));
    show("floor(inf)", math::floor(inf));
    show("floor(nan)", math::floor(nan));
    show("pow(0, 0)", math::pow(zero, zero));
    show("pow(-8, 1/3)", math::pow(-8.0, 1.0 / 3.0));
    show("pow(2, -1)", math::pow(2.0, -1.0));
    show("pow(0, -1)", math::pow(zero, -1.0));
    show("sin(inf)", math::sin(inf));
    show("sin(0)", math::sin(zero));
    show("cos(0)", math::cos(zero));
    show("tan(0)", math::tan(zero));
    show("atan2(0, -1)", math::atan2(zero, -1.0));
    show("atan2(-0, -1)", math::atan2(negzero, -1.0));
    show("atan2(1, 1)", math::atan2(1.0, 1.0));
    show("hypot(3, 4)", math::hypot(3.0, 4.0));
    show("hypot(inf, nan)", math::hypot(inf, nan));
    // Ordinary arguments: the C library computes these at run time on both backends.
    show("sqrt(2)", math::sqrt(2.0));
    show("sin(0.5)", math::sin(0.5));
    show("cos(1.7)", math::cos(1.7));
    show("tan(2.3)", math::tan(2.3));
    show("exp(1.5)", math::exp(1.5));
    show("log(2.5)", math::log(2.5));
    show("log2(5)", math::log2(5.0));
    show("log10(7)", math::log10(7.0));
    show("pow(1.7, 2.3)", math::pow(1.7, 2.3));
    show("atan2(0.3, -0.7)", math::atan2(0.3, -0.7));
    show("hypot(1.1, 2.2)", math::hypot(1.1, 2.2));
    show("pi", float64::pi);
    show("e", float64::e);
    show("tau", float64::tau);
    float32 small = 2.0;
    io::outln(f"sqrt32: ${math::sqrt(small)::text()}");
    io::outln(f"pi32: ${float32::pi::text()}");
    io::outln(f"e32: ${float32::e::text()}");
    io::outln(f"sin32: ${math::sin(float32::pi)::text()}");
}
