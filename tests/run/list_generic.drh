in io;

T sum_first<T>(&T[?] xs) {
    return xs[0] + xs[1];
}

uint64 count<T>(&T[?] xs) {
    return xs::len();
}

none fill<T>(&mut T[?] xs, T a, T b) {
    xs::push(a);
    xs::push(b);
}

none main() {
    uint32[?] nums = [4, 5, 6];
    io::outln(sum_first(&nums)::text());
    string[?] names = ["a", "b"];
    io::outln(count(&names)::text());
    mut string[?] more;
    fill(&mut more, "x", "y");
    io::outln(more[1]);
    mut float64[?] fs;
    fill<float64>(&mut fs, 1.5, 2.5);
    io::outln(sum_first(&fs)::text());
}
