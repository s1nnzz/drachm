in io;

struct Person {
    public:
    string name;
    uint32 age;
    Person(string n) {
        self.name = n;
        self.age = 0;
    }
    Person(auto);
}

sint32 main() {
    Person a = "Sam";
    Person b = "Ann", 30;
    io::outln(a.name + " " + a.age::text());
    io::outln(b.name + " " + b.age::text());
    return 0;
}
