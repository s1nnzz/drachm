failure Mismatch {
    Units "units differ" exit 6,
}

struct Port {
public:
    uint32 n;
    uint32 unit;

    Port +(Port o) fails Mismatch {
        return o;
    }
    bool ==(Port o) fails Mismatch {
        return true;
    }
    bool <(Port o) fails Mismatch {
        return true;
    }
}

none main() {
    mut Port a = 1, 1;
    Port b = 1, 1;
    a += b;
    a = a + b;
    if (a == b) { }
    bool c = a < b;
    bool d = a != b;
}
