        case seven() { }
        case 9..2 { }
        case 1, _ { }
        case true { }
        case _ { }
    }
    match (b) {
        case 1 { }
        case false..true { }
        case _ { }
    }
    match ("text") {
        case 1 { }
        case _ { }
    }
    match (nothing()) {
        case _ { }
    }
}
