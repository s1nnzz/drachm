in io;

struct Player {
public:
    string name;
    mut uint32 hp;
}

uint64 size(&string s) {
    return s::len();
}

none shout(&mut string s) {
    s = s::upper();
}

none hurt(&mut Player p) {
    p.hp = p.hp - 1;
}

&string name_of(&Player p) {
    return &p.name;
}

none main() {
    mut string word = "hello";
    io::outln(size(&word)::text());
    shout(&mut word);
    io::outln(word);

    mut Player p = "Illy", 10;
    hurt(&mut p);
    &string n = name_of(&p);
    io::outln(n + " " + p.hp::text());
}
