in io;

struct Parser lives src {
public:
    &string src;
    uint32 pos;
    none advance() { self.pos += 1; }
    uint64 left() { return self.src::len() - self.pos; }
}

none main() {
    string text = "hello world";
    mut Parser p = &text, 0;
    p::advance();
    p::advance();
    io::outln(p.pos::text());
    io::outln(p::left()->text());
    io::outln(text);
}
