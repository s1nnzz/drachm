in io;

none main() {
    uint32 million = 1_000_000;
    uint32 mask = 0xff;
    uint8 flags = 0b101;
    uint32 mode = 0o17;
    io::outln(million::text());
    io::outln(mask::text());
    io::outln(flags::text());
    io::outln(mode::text());

    // A suffix picks the type.
    uint8 byte = 255u8;
    sint8 cold = -5s8;
    float32 half = 2.5f32;
    io::outln(byte::text());
    io::outln(cold::text());
    io::outln(half::text());

    // Constants are exact until they reach a type.
    io::outln((0.1 + 0.2)::text());
    io::outln((2 ** 100)::text());
    io::outln(1e21::text());
}
