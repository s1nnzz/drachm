//--!$overflow: saturate
in io;
in si;

uint8 brighten(uint8 level, uint8 amount) {
    return level + amount;
}

none main() {
    io::outln(f"${brighten(100, 50)}");
    io::outln(f"${brighten(200, 100)}");
    sint32 reading = 700;
    io::outln(f"${reading::to<uint8>()}");
    uint32 one = 1;
    uint32 shift = 40;
    io::outln(f"${one << shift}");
    // A negative amount shifts the other way; bits past the width fall off.
    uint8 level = 200;
    sint32 back = -1;
    io::outln(f"${8 >> -1} ${level >> back} ${8 << -1}");
    float64 zero = 0.0;
    float64 infinity = 1.0 / zero;
    io::outln(f"${infinity::to<uint8>()} ${(-infinity)::to<uint8>()} ${(zero / zero)::to<uint8>()}");
    // Unit scaling follows the setting too: the metres stop at the end of the type.
    sint64 metres = 9000000000000000000;
    sint64<km> trip = metres * 1<km>;
    io::outln(f"${trip::in<m>()}");
}
