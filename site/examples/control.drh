in io;

sint32 classify(sint32 n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

uint32 countDown(mut uint32 n) {
    mut uint32 steps = 0;
    while (n > 0) {
        n--;
        steps++;
    }
    return steps;
}

none main() {
    // if / else if / else, and a function that returns from each branch.
    io::outln(classify(-5)::text());
    io::outln(classify(0)::text());
    io::outln(classify(5)::text());

    // while
    io::outln(countDown(4)::text());

    // C-style for: the first part runs once, then the test, then the step.
    mut uint32 sum = 0;
    for (mut uint32 i = 0; i < 5; i++) {
        sum += i;
    }
    io::outln(sum::text());

    // for over an inclusive range.
    for (uint32 n of 1..3) {
        io::out(n::text());
        io::out(" ");
    }
    io::outln("");

    // break and continue. Odd numbers only, then stop past 6.
    for (uint32 i of 0..9) {
        if (i % 2 == 0) { continue; }
        if (i > 6) { break; }
        io::out(i::text());
    }
    io::outln("");

    // A number after break or continue counts loops outward.
    for (uint32 a of 1..3) {
        for (uint32 b of 1..3) {
            if (b == 2) { continue 2; }
            if (a == 3) { break 2; }
            io::out(a::text() + b::text() + " ");
        }
    }
    io::outln("");

    // skip leaves an if block: here the rest of the outer block is skipped.
    if (true) {
        io::out("inside ");
        if (sum > 5) {
            skip;
        }
        io::out("never ");
    }
    io::outln("after");

    // match on numbers: each case is tried in order; `_` takes the rest.
    for (uint32 score of 0..3) {
        match (score) {
            case 0 { io::outln("zero"); }
            case 1, 2 { io::outln("one or two"); }
            case _ { io::outln("more"); }
        }
    }
}
