in io;

none main() {
    uint32 answer = 42;
    mut sint8 cold = -12;
    cold = cold - 3;
    io::outln(answer::text());
    io::outln(cold::text());

    // A binding with no value must get exactly one before it is read.
    uint32 later;
    if (answer > 40) {
        later = 1;
    } else {
        later = 2;
    }
    io::outln(later::text());
}
