in io;

uint32? pick(uint32 n) {
    if (n % 2 == 0) { return n; }
    return none;
}

string? name(uint32 n) {
    if (n == 1) { return "Ann"; }
    return none;
}

none main() {
    io::outln((pick(8) maybe 0)::text());
    io::outln((pick(7) maybe 0)::text());
    io::outln(name(1) maybe "nobody");
    io::outln(name(2) maybe "nobody");
    uint32 total = (pick(4) maybe 1) + (pick(3) maybe 1);
    io::outln(total::text());
}
