in io;
in math;

none main() {
    float64 hypotenuse = math::sqrt(3.0 * 3.0 + 4.0 * 4.0);
    io::outln(f"hypotenuse ${hypotenuse}");
    io::outln(f"hypot ${math::hypot(5.0, 12.0)}");
    io::outln(f"2 to the 10th ${math::pow(2.0, 10.0)}");
    io::outln(f"e to the 1 ${math::exp(1.0)}");
    io::outln(f"logs ${math::log(math::exp(2.0))} ${math::log2(1024.0)} ${math::log10(0.001)}");
    io::outln(f"rounding ${math::floor(2.7)} ${math::ceil(2.2)} ${math::round(2.5)} ${math::round(-2.5)}");
    io::outln(f"floor of a negative ${math::floor(-0.5)}");
    io::outln(f"cos 0 is ${math::cos(0.0)}, sin 0 is ${math::sin(0.0)}, tan 0 is ${math::tan(0.0)}");
    io::outln(f"atan2 ${math::atan2(1.0, 1.0)}");
    io::outln(f"abs ${math::abs(-3.5)}, min ${math::min(2.5, 1.5)}, max ${math::max(2.5, 1.5)}");
    io::outln(f"clamp ${math::clamp(12.0, 0.0, 10.0)} ${math::clamp(-3.0, 0.0, 10.0)} ${math::clamp(4.0, 0.0, 10.0)}");
}
