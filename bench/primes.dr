// Loop-heavy: count primes below 5,000,000 by trial division.
fn is_prime(n: i64) -> bool {
    if n < 2 { return false; }
    var d: i64 = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d = d + 1;
    }
    return true;
}

fn main() {
    var i: i64 = 0;
    var count: i64 = 0;
    while i < 5000000 {
        if is_prime(i) { count = count + 1; }
        i = i + 1;
    }
    print(count);
}
